{
  // internal-ai.dev is a Worker serving ./site as static assets; this account
  // has no Pages project, so `npx wrangler deploy` from the repository root is
  // the publish step. The Worker runs first only to answer /api/access and to
  // send www to the apex; everything else is handed to the assets layer, which
  // still applies site/_headers and the Worker's default routing behaviour.
  "name": "internal-ai",
  "main": "./worker/index.js",
  "compatibility_date": "2024-01-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
